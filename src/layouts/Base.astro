---
import '../styles/tokens.css';
import '../styles/global.css';

const {
  title = 'Kyle Cromwell — Personal Field Atlas',
  description = 'Kyle Cromwell’s personal atlas of visited countries, interesting places, and retired hobbies.',
} = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (route) => pathname === route || pathname.startsWith(route);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a href="/" class="nav-name">Kyle Cromwell</a>
        <div class="nav-links">
          <a href="/countries/" aria-current={isCurrent('/countries/') ? 'page' : undefined}>Visited Countries</a>
          <a href="/places/" aria-current={isCurrent('/places/') ? 'page' : undefined}>Interesting Places</a>
          <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About Me</a>
        </div>
      </nav>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; 2026 Kyle Cromwell</p>
      <p>Personal field atlas · Always in progress</p>
    </footer>
  </body>
</html>
