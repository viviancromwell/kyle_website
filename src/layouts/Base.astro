---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import cormorant500 from '../assets/fonts/cormorant-sc-500-latin.woff2?url';
import cormorant600 from '../assets/fonts/cormorant-sc-600-latin.woff2?url';
import FieldRoutes from '../components/FieldRoutes.astro';

const {
  title = 'Kyle Cromwell — Personal Field Atlas',
  description = 'My personal atlas of visited countries, interesting places, and retired hobbies.',
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isShowcase = pathname.startsWith('/showcase');
const isCurrent = (route) => pathname === route || pathname.startsWith(route);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5D4099" />
    {/* Both weights are above the fold on every page, and would otherwise
        only be discovered once the stylesheet parses. The latin-ext cuts stay
        behind their unicode-range gate. */}
    <link rel="preload" as="font" type="font/woff2" href={cormorant500} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cormorant600} crossorigin />
  </head>
  <body class:list={{ 'home-route': isHome, 'showcase-route': isShowcase }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      !isHome && !isShowcase && (
        <header class="site-header">
          <FieldRoutes variant="dark" />
          <nav class="site-nav" aria-label="Main">
            <a href="/" class="nav-name">Kyle Cromwell</a>
            <div class="nav-links">
              <a href="/countries/" aria-current={isCurrent('/countries/') ? 'page' : undefined}>Visited Countries</a>
              <a href="/places/" aria-current={isCurrent('/places/') ? 'page' : undefined}>Interesting Places</a>
              <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About Me</a>
            </div>
          </nav>
        </header>
      )
    }
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; 2026 Kyle Cromwell</p>
      <p>
        kylecromwell2023 [at] gmail [dot] com ·
        <a href="https://www.linkedin.com/in/kylecromwell/">LinkedIn</a>
      </p>
    </footer>
  </body>
</html>
