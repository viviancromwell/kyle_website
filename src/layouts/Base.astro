---
import '../styles/tokens.css';
import '../styles/global.css';

const { title = 'Vivian Cromwell — Portfolio', description = 'Portfolio of an emerging designer.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a href="/" class="nav-name">Vivian Cromwell</a>
        <div class="nav-links">
          <details class="nav-menu">
            <summary>Work</summary>
            <ul class="nav-submenu" aria-label="Work categories">
              <li><a href="/work/">All Work</a></li>
              <li><a href="/work/#portraits">Portraits</a></li>
              <li><a href="/work/#maternity">Maternity</a></li>
              <li><a href="/work/#events">Events</a></li>
            </ul>
          </details>
          <a href="/about/">About</a>
        </div>
      </nav>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; 2026 Vivian Cromwell</p>
    </footer>
  </body>
</html>
