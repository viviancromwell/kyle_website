---
const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';

// Continuous diagonals for the leather-cover lattice; per-tile patterns
// restart the dash cycle at every seam and read as chevron ticks.
const PITCH = 104;
const downRight = Array.from({ length: 20 }, (_, i) => -728 + i * PITCH);
const downLeft = Array.from({ length: 20 }, (_, i) => 56 + i * PITCH);
---

<svg
  class:list={['field-routes', `field-routes--${variant}`]}
  viewBox="0 0 1200 720"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    isDark ? (
      <>
        <g class="field-routes__lines">
          {downRight.map((x) => (
            <path d={`M${x} 0l720 720`} />
          ))}
          {downLeft.map((x) => (
            <path d={`M${x} 0l-720 720`} />
          ))}
        </g>
        <g class="field-routes__nodes">
          <circle cx="628" cy="312" r="7" />
          <circle cx="836" cy="416" r="8" />
          <circle cx="1044" cy="312" r="6" />
          <circle cx="1148" cy="416" r="7" />
          <circle cx="732" cy="306" r="5" />
        </g>
        <g class="field-routes__accents">
          <path d="m728 412 11 11m0-11-11 11" />
          <path d="m944 302 10 10m0-10-10 10" />
          <path d="m1090 366 10 10m0-10-10 10" />
          <path d="m628 442 10 10m0-10-10 10" />
        </g>
      </>
    ) : (
      <>
        {/* One connected journey web: every ring and every cross sits on a
            route vertex, so nothing floats free of the dashed lines. */}
        <g class="field-routes__lines">
          <path d="M-60 150 120 90l180 60 170-50 170 70 180-50" />
          <path d="M540 60l160 70 180-60 200 70 180-50" />
          <path d="M-40 420 140 360l190 70 190-50 180 70" />
          <path d="M900 300l160 80 180-50" />
          <path d="M200 630 380 560l180 80 200-60 190 60 170-50" />
          <path d="M60 250l120-40 160 60 160-40" />
          <path d="M430 260l130 90 160-50 160 60 140-50 140-50" />
          <path d="M100 500l160-30 160 50" />
          <path d="M640 170l-80 180" />
          <path d="M820 120l80 180" />
          <path d="M330 430l50 130" />
          <path d="M1060 380l60 210" />
        </g>
        <g class="field-routes__nodes">
          <circle cx="120" cy="90" r="6" />
          <circle cx="300" cy="150" r="5" />
          <circle cx="470" cy="100" r="6" />
          <circle cx="640" cy="170" r="5" />
          <circle cx="700" cy="130" r="5" />
          <circle cx="880" cy="70" r="6" />
          <circle cx="1080" cy="140" r="5" />
          <circle cx="140" cy="360" r="6" />
          <circle cx="330" cy="430" r="5" />
          <circle cx="520" cy="380" r="6" />
          <circle cx="1060" cy="380" r="6" />
          <circle cx="380" cy="560" r="5" />
          <circle cx="760" cy="580" r="6" />
          <circle cx="950" cy="640" r="5" />
          <circle cx="180" cy="210" r="4.5" />
          <circle cx="340" cy="270" r="5" />
          <circle cx="560" cy="350" r="5" />
          <circle cx="880" cy="360" r="5" />
          <circle cx="260" cy="470" r="4.5" />
          <circle cx="1240" cy="330" r="6" />
        </g>
        <g class="field-routes__accents">
          <path d="m814.5 114.5 11 11m0-11-11 11" />
          <path d="m694.5 444.5 11 11m0-11-11 11" />
          <path d="m494.5 224.5 11 11m0-11-11 11" />
          <path d="m1014.5 304.5 11 11m0-11-11 11" />
          <path d="m1114.5 584.5 11 11m0-11-11 11" />
          <path d="m414.5 514.5 11 11m0-11-11 11" />
          <path d="M900 291v18m-9-9h18" />
          <path d="M560 631v18m-9-9h18" />
          <path d="M60 241v18m-9-9h18" />
          <path d="M1160 251v18m-9-9h18" />
        </g>
      </>
    )
  }
</svg>
