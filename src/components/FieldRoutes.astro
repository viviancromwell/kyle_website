---
const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';

// Continuous diagonals for the leather-cover lattice; per-tile patterns
// restart the dash cycle at every seam and read as chevron ticks.
const PITCH = 104;
const downRight = Array.from({ length: 20 }, (_, i) => -728 + i * PITCH);
const downLeft = Array.from({ length: 20 }, (_, i) => 56 + i * PITCH);
---

<svg
  class:list={['field-routes', `field-routes--${variant}`]}
  viewBox="0 0 1200 720"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    isDark ? (
      <>
        <g class="field-routes__lines">
          {downRight.map((x) => (
            <path d={`M${x} 0l720 720`} />
          ))}
          {downLeft.map((x) => (
            <path d={`M${x} 0l-720 720`} />
          ))}
        </g>
        <g class="field-routes__nodes">
          <circle cx="628" cy="312" r="7" />
          <circle cx="836" cy="416" r="8" />
          <circle cx="1044" cy="312" r="6" />
          <circle cx="1148" cy="416" r="7" />
        </g>
        <g class="field-routes__accents">
          <path d="m728 412 11 11m0-11-11 11" />
          <path d="m944 302 10 10m0-10-10 10" />
          <path d="m1090 366 10 10m0-10-10 10" />
        </g>
      </>
    ) : (
      <>
        <g class="field-routes__lines">
          <path d="M-40 88c70-34 128 26 198 4s130-44 200-10 138 40 208 8 140-36 210-4 132 34 202 6" />
          <path d="M-30 470c76-40 140 24 212 0s136-38 206-6 138 36 208 6 138-32 208-2 130 30 200 4" />
          <path d="M300-30c40 62 30 118-12 168s-50 104-8 158" />
          <path d="M905-25c-36 58-28 112 12 160s52 100 16 154" />
        </g>
        <g class="field-routes__nodes">
          <circle cx="158" cy="80" r="5.5" />
          <circle cx="358" cy="86" r="6" />
          <circle cx="566" cy="98" r="5" />
          <circle cx="774" cy="92" r="6" />
          <circle cx="982" cy="96" r="5" />
          <circle cx="182" cy="452" r="6" />
          <circle cx="600" cy="470" r="5.5" />
          <circle cx="1006" cy="472" r="6" />
        </g>
        <g class="field-routes__accents">
          <path d="m262 60 11 11m0-11-11 11" />
          <path d="M478 52v18m-9-9h18" />
          <path d="m700 350 11 11m0-11-11 11" />
          <path d="m1076 64 11 11m0-11-11 11" />
          <path d="m86 540 10 10m0-10-10 10" />
        </g>
      </>
    )
  }
</svg>
