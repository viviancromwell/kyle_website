---
const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';
---

<svg
  class:list={['field-routes', `field-routes--${variant}`]}
  viewBox="0 0 1200 720"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    isDark ? (
      <>
        <g class="field-routes__lines">
          <path d="M-100 520 250 160 590 500 920 150 1290 520" />
          <path d="M-90 210 240 540 555 215 880 545 1190 220 1300 330" />
          <path d="M20 700 365 350 705 700" />
          <path d="M665 40 1000 375 1260 105" />
        </g>
        <g class="field-routes__nodes">
          <circle cx="250" cy="160" r="10" />
          <circle cx="240" cy="540" r="9" />
          <circle cx="590" cy="500" r="11" />
          <circle cx="555" cy="215" r="8" />
          <circle cx="880" cy="545" r="10" />
          <circle cx="920" cy="150" r="8" />
          <circle cx="1190" cy="220" r="7" />
        </g>
        <g class="field-routes__accents">
          <path d="m1050 565 18 18m0-18-18 18" />
          <path d="m740 115 14 14m0-14-14 14" />
        </g>
      </>
    ) : (
      <>
        <g class="field-routes__lines">
          <path d="M-80 105C45 25 120 170 245 95S455 45 565 125s210 105 330-10 225-80 365-25" />
          <path d="M-60 500c120-125 235 75 355-25s260-145 385-20 285 125 430 10 190-95 245-60" />
          <path d="M265-45c85 95 110 190 45 280s-25 180 70 245" />
          <path d="M940-35c-70 110-45 205 40 285s105 175 35 275" />
        </g>
        <g class="field-routes__nodes">
          <circle cx="78" cy="89" r="8" />
          <circle cx="245" cy="95" r="9" />
          <circle cx="565" cy="125" r="10" />
          <circle cx="895" cy="115" r="8" />
          <circle cx="295" cy="475" r="9" />
          <circle cx="680" cy="455" r="8" />
          <circle cx="1110" cy="465" r="10" />
        </g>
        <g class="field-routes__accents">
          <path d="m175 52 16 16m0-16-16 16" />
          <path d="M498 48v28m-14-14h28" />
          <path d="m620 350 18 18m0-18-18 18" />
          <path d="m1085 75 17 17m0-17-17 17" />
        </g>
      </>
    )
  }
</svg>
