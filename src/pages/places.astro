---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PlacesCarousel from '../components/PlacesCarousel.vue';
import FieldRoutes from '../components/FieldRoutes.astro';
import { interestingPlaces } from '../data/interestingPlaces.mjs';
import { placeAlt } from '../data/placeAlt.mjs';

const placeImages = import.meta.glob('../assets/places/*', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;

const PRINT_WIDTHS = [360, 540, 720];
// Matches the aspect-ratio the carousel print is displayed at.
const CAROUSEL_RATIO = 4 / 3;
const SPREAD_WIDTHS = [720, 1080, 1440];

// Several of the originals are only a few hundred pixels wide; asking for
// widths above the source would ship upscaled files with no extra detail.
const widthsFor = (source: ImageMetadata, candidates: number[]) => {
  const usable = candidates.filter((width) => width <= source.width);
  return usable.length ? usable : [source.width];
};

const entries = interestingPlaces.map((place, index) => {
  const source = placeImages[`../assets/places/${place.image}`];

  return {
    ...place,
    source,
    alt: placeAlt[place.image] ?? place.title,
    // Two of the originals are panoramas; they cross the whole spread rather
    // than squeezing into one column.
    spread: source.width / source.height > 2.2,
    // Low-resolution originals print small so they stay sharp.
    small: source.width < 700,
    tilt: index % 6,
    tape: index % 3,
    tuck: index % 2 === 1,
  };
});

// No plate is held back any more. The masthead used to feature the first
// place as a large static print with its own note, which did the same job the
// carousel now does and left the carousel one short of the twenty-five the
// intro promises. Every place goes through the same presentation.
const collage = entries;

// The Vue island cannot import astro:assets, so every photograph is
// optimised here and handed across as plain src/srcset strings.
// The carousel crops every print to 4:3 and centres it, so a portrait
// original shipped whole was paying for a thousand rows of pixels that
// object-fit threw away — the two tallest were 245 KiB each. Cropping here
// hands over the same visible pixels at half the weight. The collage below
// still uses the uncropped files: it shows the whole photograph.
const carouselSlides = await Promise.all(
  collage.map(async (place) => {
    // One call per width rather than `widths`, which pairs with neither a
    // crop nor a height: each variant is cut to the carousel's ratio here.
    const widths = widthsFor(place.source, PRINT_WIDTHS);
    const variants = await Promise.all(
      widths.map((width) =>
        getImage({
          src: place.source,
          width,
          height: Math.round(width / CAROUSEL_RATIO),
          fit: 'cover',
          position: 'center',
          format: 'webp',
        })
      )
    );

    return {
      src: variants[variants.length - 1].src,
      srcset: variants.map((variant, i) => `${variant.src} ${widths[i]}w`).join(', '),
      alt: place.alt,
      title: place.title,
      description: place.description,
      tape: place.tape,
      tilt: [1.5, -1.25, 2.25, -2, 1, -2.75][place.tilt] ?? 0,
    };
  })
);
---

<Base
  title="Interesting Places — Kyle Cromwell"
  description="Twenty-five places from my journal, with the photographs and the writing I collected with them."
>
  <script is:inline>
    // Both presentations of these photographs sit in this page: the collage
    // is what the HTML holds, the carousel is what the island replaces it
    // with. Marking the document here, before the collage parses, keeps
    // twenty-five files off the network for everyone who is going to get the
    // carousel — the browser treats them all as near the viewport and fetched
    // every one. Without JS this never runs and the collage stands. If the
    // island is slow or never arrives, the collage comes back.
    document.documentElement.dataset.placesCarousel = 'pending';

    setTimeout(() => {
      if (document.documentElement.dataset.placesCarousel !== 'pending') return;
      delete document.documentElement.dataset.placesCarousel;
      document.dispatchEvent(new Event('places:collage-restored'));
    }, 5000);
  </script>

  <div class="places-page">
    <header class="places-plate">
      <FieldRoutes variant="light" />

      <div class="places-plate-inner">
        <div class="places-plate-copy reveal">
          <h1>Interesting Places</h1>
          <p class="places-kicker">Field Notes</p>
        </div>

        {/* The intro crosses to the right, where the featured print used to
            hang, so the masthead spans the measure instead of trailing off
            into empty wall. */}
        <p class="places-intro reveal reveal--late">
          Twenty-five places that held my attention. The prints and the writing under them
          are kept as I first collected them.
        </p>
      </div>
    </header>

    {/*
      client:idle, not client:visible. The component hides its own section
      until it mounts so a failed bundle cannot leave a tall transparent gap,
      and a hidden element never triggers the visibility observer — the two
      together deadlock, and the carousel simply never appears. Idle has no
      such dependency, and the photographs inside are lazy regardless.
    */}
    <PlacesCarousel slides={carouselSlides} client:idle />

    <section class="places-collage" aria-label="Places from my journal">
      <ul class="places-collage-inner" role="list">
        {collage.map((place) => (
          <li class:list={['places-entry', { 'places-entry--spread': place.spread }]}>
            <figure
              class:list={[
                'places-print',
                `places-print--t${place.tilt}`,
                {
                  'places-print--small': place.small && !place.spread,
                  'places-print--tuck': place.small && !place.spread && place.tuck,
                },
              ]}
            >
              <span class:list={['places-tape', `places-tape--${place.tape}`]} aria-hidden="true"></span>
              <span class="places-window">
                <Image
                  src={place.source}
                  alt={place.alt}
                  widths={widthsFor(place.source, place.spread ? SPREAD_WIDTHS : PRINT_WIDTHS)}
                  sizes={
                    place.spread
                      ? '(min-width: 78rem) 68rem, 88vw'
                      : '(min-width: 72rem) 22rem, (min-width: 48rem) 42vw, 88vw'
                  }
                  loading="lazy"
                />
              </span>
              <figcaption><h2>{place.title}</h2></figcaption>
            </figure>
            <p class="places-note">{place.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="places-band" aria-labelledby="places-band-title" data-band>
      <FieldRoutes variant="dark" />
      <div class="places-band-inner">
        <h2 id="places-band-title">More of the journal</h2>
        <nav class="places-band-links" aria-label="More of the journal">
          <a href="/countries/">Visited Countries</a>
          <a href="/about/">About Me</a>
        </nav>
      </div>
    </section>
  </div>

  <script>
    import { animate, scroll } from 'motion';

    // Prints drift at different rates as the page moves, so the collage reads
    // as photographs lying loose on the paper rather than printed into it.
    //
    // The subject is the <li>, not the print inside it: .places-print carries
    // its own rotate() for the tilt, and animating `transform` on that element
    // would overwrite the tilt rather than compose with it. The <li> has no
    // transform of its own, so it is free to take one.
    //
    // Literal transform strings rather than Motion's `y` shorthand — the
    // shorthand animates an independent value on the main thread (A-tier),
    // while a transform string stays on the compositor via ScrollTimeline.
    // Twenty-four oversized photographs each get their own compositor layer
    // while they drift, which measured as a GPU tier of C on mobile against
    // S on desktop. The collage is a single column on small screens anyway,
    // where parallax between neighbours has nothing to play against, so it
    // is simply not worth the memory there.
    const wideEnough = matchMedia('(min-width: 48rem)').matches;

    const startDrift = () => {
      // Percentages of the image's own height, so a tall print and a small
      // one drift proportionally rather than the small one barely moving.
      // The 1.18 scale in CSS gives 9% of headroom at each edge; staying
      // under that is what keeps a gap from appearing at the frame.
      const depths = [7, 4, 8, 5];

      document.querySelectorAll('.places-window img').forEach((img, index) => {
        const drift = depths[index % depths.length];

        scroll(
          animate(
            img,
            {
              transform: [
                `translateY(${-drift}%) scale(1.18)`,
                `translateY(${drift}%) scale(1.18)`,
              ],
            },
            { ease: 'linear' }
          ),
          // The full pass: from the print's top edge meeting the bottom of
          // the viewport to its bottom edge leaving the top. Without this the
          // drift is packed into the tail of the crossing and sits clamped
          // for most of the time the photograph is actually on screen.
          { target: img, offset: ['start end', 'end start'] }
        );
      });
    };

    // Only the collage drifts, and it is retired the moment the carousel is
    // on its way, so setting up twenty-four scroll timelines behind a hidden
    // section is pure cost. The restore event is the fallback path: if the
    // island never arrived and the collage came back, it drifts after all.
    if (wideEnough && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (document.documentElement.dataset.placesCarousel) {
        document.addEventListener('places:collage-restored', startDrift, { once: true });
      } else {
        startDrift();
      }
    }
  </script>
</Base>

<style>
  /* The interior shell still carries the starter ground (near-white plus a
     ruled grid overlay). Astro bundles page styles per route, so these three
     rules repaint the canvas for /places/ only, until the shell itself moves
     onto the journal system. */
  :global(body) {
    color: var(--color-soft-charcoal);
    background: var(--color-paper);
  }

  :global(body::before) {
    display: none;
  }

  :global(.page) {
    max-width: none;
    padding: 0;
  }

  /* --- The opening plate ------------------------------------------------ */

  /* One continuous sheet under the whole page: the same wall ground as the
     home hero, so the two surfaces read as one site. */
  .places-page {
    background: var(--color-paper) url("../assets/home/wall-white.webp") left top / 64rem auto repeat;
  }

  .places-plate {
    position: relative;
    overflow-x: clip;
    padding: var(--space-2xl) var(--space-hero-gutter) 0;
  }

  /* Coral owns this page, so the route web's crosses and ticks are drawn in
     the coral companion rather than the violet the countries page uses. */
  .places-plate :global(.field-routes--light .field-routes__accents) {
    stroke: var(--color-collegiate-coral-soft);
  }

  .places-plate-inner,
  .places-collage-inner,
  .places-band-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width-page);
    margin-inline: auto;
  }

  .places-plate-inner {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }

  .places-plate-copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  .places-plate-copy h1,
  .places-plate-copy p {
    margin-bottom: 0;
  }

  /* Coral rule with a ring at its open end: the countries page's violet
     signature, in this page's role color. */
  .places-plate-copy h1 {
    position: relative;
    width: fit-content;
    padding-right: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: var(--border-width) solid var(--color-collegiate-coral);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .places-plate-copy h1::after {
    position: absolute;
    right: 0;
    bottom: calc(var(--hero-ring-hole) * -1);
    width: calc(var(--hero-ring-hole) * 2);
    height: calc(var(--hero-ring-hole) * 2);
    border: var(--border-width) solid var(--color-collegiate-coral);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    content: "";
  }

  .places-kicker {
    color: var(--color-collegiate-coral);
    font-family: var(--font-display);
    font-size: var(--text-hero-kicker);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .places-intro {
    max-width: var(--max-width-narrow);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  /* --- Prints ------------------------------------------------------------ */

  /* The collage is what the page is without JS, and what it falls back to if
     the island never arrives. Any value of the attribute retires it — pending
     while the carousel is on its way, ready once it is running — as display:
     none rather than a visual trick, so the same 24 places are not left in the
     accessibility tree behind the carousel. */
  :global([data-places-carousel]) .places-collage {
    display: none;
  }

  /* The other side of that swap. Without JS the attribute is never set, the
     collage stands, and the island's static first print would otherwise show
     the same photograph twice over. */
  :global(html:not([data-places-carousel]) .places-carousel-seat) {
    display: none;
  }

  .places-print {
    position: relative;
    width: 100%;
    margin: 0;
    padding: var(--space-sm);
    border-radius: var(--radius-print);
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-note);
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  .places-print img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The photograph moves against its own border rather than the whole print
     moving down the page. Drifting the card gave about 44px of travel spread
     across a full viewport pass — roughly 3% of the scroll distance, which
     is not perceptible. Held inside a fixed window the same movement is read
     against a stationary edge, which is what makes parallax legible.
     The window keeps the print's aspect so nothing reflows; the image is
     oversized inside it so there is room to travel without exposing a gap. */
  /* clip, not hidden: `overflow: hidden` makes this a scroll container, and
     the scroll timeline then binds to it instead of the page. It never
     scrolls, so every image sat clamped at the end of its drift. `clip`
     clips without creating a scrollport. */
  .places-window {
    display: block;
    overflow: clip;
  }

  /* No will-change here. It was on all 24 images and cost a GPU tier — S to
     A on desktop, C on mobile — for nothing: the scroll animation is WAAPI,
     which promotes the layer on its own. */
  /* The oversize only exists to give the drift somewhere to go, so it is
     applied at the same breakpoint the drift is, and never under reduce —
     otherwise the photograph is silently cropped for no reason. */
  @media (min-width: 48rem) and (prefers-reduced-motion: no-preference) {
    .places-window img {
      transform: scale(1.18);
    }
  }

  .places-print figcaption {
    padding-top: var(--space-xs);
    color: var(--color-caption-ink);
    font-size: var(--text-sm);
    font-style: italic;
    text-align: center;
  }

  .places-print figcaption h2 {
    margin: 0;
    font: inherit;
    letter-spacing: normal;
    font-weight: 600;
  }

  /* Rotation is the print's alone; the writing under it stays level, the way
     a photograph sits crooked on a page the notes are ruled onto. */
  .places-print--t0 {
    transform: rotate(1.5deg);
  }

  .places-print--t1 {
    transform: rotate(-1.25deg);
  }

  .places-print--t2 {
    transform: rotate(2.25deg);
  }

  .places-print--t3 {
    transform: rotate(-2deg);
  }

  .places-print--t4 {
    transform: rotate(1deg);
  }

  .places-print--t5 {
    transform: rotate(-2.75deg);
  }

  /* Straightening the print, not lifting it: nothing here is pressable. */
  @media (hover: hover) {
    .places-print:hover {
      box-shadow: var(--shadow-paper);
      transform: rotate(0deg);
    }
  }

  .places-print--small {
    width: 66%;
  }

  .places-print--tuck {
    margin-left: auto;
  }

  .places-print--plate {
    max-width: var(--max-width-narrow);
  }

  /* --- Washi tape -------------------------------------------------------- */

  .places-tape {
    position: absolute;
    z-index: 1;
    height: calc(var(--hero-tape-height) * 0.72);
    background: url("../assets/home/tape-washi.png") center / cover no-repeat;
    box-shadow: var(--shadow-tape);
    clip-path: polygon(
      0 8%, 1.5% 0, 98% 3%, 100% 10%, 98.8% 32%, 100% 52%, 98.5% 78%, 100% 94%,
      97.5% 100%, 2% 97%, 0 88%, 1.2% 66%, 0 42%, 1% 18%
    );
    opacity: 0.9;
  }

  .places-tape--0 {
    top: calc(var(--hero-tape-height) * -0.34);
    left: var(--space-lg);
    width: calc(var(--hero-tape-width) * 0.6);
    transform: rotate(-11deg);
  }

  .places-tape--1 {
    top: calc(var(--hero-tape-height) * -0.32);
    right: var(--space-xl);
    width: calc(var(--hero-tape-width) * 0.52);
    transform: rotate(8deg);
  }

  .places-tape--2 {
    top: calc(var(--hero-tape-height) * -0.38);
    left: 50%;
    width: calc(var(--hero-tape-width) * 0.72);
    transform: translateX(-50%) rotate(-2.5deg);
  }

  .places-tape--plate {
    top: calc(var(--hero-tape-height) * -0.4);
    left: 50%;
    width: var(--hero-tape-width);
    height: var(--hero-tape-height);
    transform: translateX(-50%) rotate(-1deg);
  }

  .places-tape--note {
    top: calc(var(--hero-tape-height) * -0.45);
    right: var(--space-xl);
    width: calc(var(--hero-tape-width) * 0.5);
    transform: rotate(6deg);
  }

  /* --- The opening note -------------------------------------------------- */

  /* Ruled sheet: the line pitch is one spacing step, the copy is set to the
     same leading, and the ruling is nudged down so the writing sits on it. */
  .places-plate-note {
    position: relative;
    max-width: var(--max-width-narrow);
    margin-top: var(--space-lg);
    margin-left: var(--space-xl);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    border: var(--border-width) solid var(--color-paper-line);
    border-radius: var(--radius-note);
    background-color: var(--color-paper-raised);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent var(--space-lg),
      var(--color-paper-line) calc(var(--space-lg) + var(--hero-pattern-line))
    );
    background-position: left calc(var(--space-xs) + var(--space-2xs) * 0.5);
    box-shadow: var(--shadow-note);
    transform: rotate(-1.25deg);
  }

  .places-plate-note p {
    margin-bottom: 0;
    line-height: var(--space-lg);
  }

  /* --- The collage ------------------------------------------------------- */

  .places-collage {
    position: relative;
    padding: var(--space-2xl) var(--space-hero-gutter) var(--space-3xl);
  }

  .places-collage-inner {
    column-gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The tape overhangs the print's top edge. Without this pad, a print that
     lands at the top of a column pushes its tape above the column, and the
     browser fragments it into an orphan at the foot of the previous one. */
  .places-entry {
    margin-bottom: var(--space-xl);
    padding-top: var(--space-lg);
    break-inside: avoid;
  }

  .places-entry--spread {
    column-span: all;
    margin-block: var(--space-xl);
  }

  .places-entry--spread .places-note {
    max-width: var(--max-width-copy);
  }

  .places-note {
    position: relative;
    margin-top: var(--space-md);
    margin-bottom: 0;
    padding-left: var(--space-lg);
    line-height: var(--leading-normal);
  }

  /* A coral ring pinned beside the writing, the same node the field routes
     draw at every junction. */
  .places-note::before {
    position: absolute;
    top: var(--space-xs);
    left: 0;
    width: calc(var(--hero-ring-hole) * 2);
    height: calc(var(--hero-ring-hole) * 2);
    border: var(--border-width) solid var(--color-collegiate-coral);
    border-radius: var(--radius-pill);
    content: "";
  }

  /* --- The closing band -------------------------------------------------- */

  /* Field violet is invisible on aubergine (1.8:1); coral soft carries the
     links and the focus ring here. */
  .places-band {
    --color-focus: var(--color-collegiate-coral-soft);

    position: relative;
    padding: var(--space-xl) var(--space-hero-gutter);
    color: var(--color-on-aubergine);
    background: var(--color-aubergine);
  }

  .places-band-inner {
    display: grid;
    gap: var(--space-md);
    padding-left: var(--space-lg);
    border-left: calc(var(--border-width) * 2) solid var(--color-collegiate-coral-soft);
  }

  .places-band h2 {
    margin: 0;
    font-size: var(--text-hero-destination);
    font-weight: 500;
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .places-band-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-xl);
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .places-band-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hero-touch-target);
    border-bottom: var(--border-width) solid var(--color-collegiate-coral-soft);
    color: var(--color-on-aubergine);
    text-decoration: none;
  }

  .places-band-links a:hover {
    border-color: var(--color-on-aubergine);
    color: var(--color-paper);
  }

  @media (min-width: 48rem) {
    /* Title and kicker left, intro right, on one row. Baseline rather than
       start: aligned to the top of the row the intro floats above the title
       and reads as unrelated to it; on baselines the first line of the intro
       meets the title and the masthead becomes a single band of type. */
    .places-plate-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-hero-section);
    }

    .places-intro {
      max-width: var(--max-width-intro);
      justify-self: end;
    }

    .places-collage-inner {
      columns: 2;
    }
  }

  @media (min-width: 72rem) {
    .places-plate-inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      padding-bottom: var(--space-xl);
    }

    .places-plate-copy {
      padding-top: var(--space-xl);
    }

    .places-collage-inner {
      columns: 3;
    }
  }
</style>
