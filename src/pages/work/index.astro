---
import Base from '../../layouts/Base.astro';
---

<Base title="Work — Vivian Cromwell">
  <h1>Work</h1>
  <p class="intro">Photography centered on people, connection, and moments worth keeping.</p>
  <div class="work-list">
    <section id="portraits" class="work-category">
      <h2>Portraits</h2>
      <p>Portrait sessions centered on personality, expression, and the details that make someone recognizable.</p>
    </section>
    <section id="maternity" class="work-category">
      <h2>Maternity</h2>
      <p>Quiet, intimate sessions documenting the anticipation and tenderness of becoming a family.</p>
    </section>
    <section id="events" class="work-category">
      <h2>Events</h2>
      <p>Candid coverage of gatherings, celebrations, and the moments that happen between the planned ones.</p>
    </section>
  </div>
</Base>

<style>
  h1 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-sm);
  }

  .intro {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-xl);
  }

  .work-list {
    display: grid;
    gap: var(--space-lg);
  }

  .work-category {
    scroll-margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .work-category h2 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .work-category p {
    margin: var(--space-2xs) 0 0;
    color: var(--color-text-secondary);
    max-width: 42em;
  }
</style>
