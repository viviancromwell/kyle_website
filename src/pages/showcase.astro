---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import machuPicchu from '../assets/places/machu-picchu-peru.jpeg';

const colors = [
  ['ds-chip--paper', '--color-paper', 'Warm Paper', 'main notebook ground'],
  ['ds-chip--paper-raised', '--color-paper-raised', 'Paper Raised', 'notepads, prints, tabs'],
  ['ds-chip--paper-muted', '--color-paper-muted', 'Paper Muted', 'panel borders'],
  ['ds-chip--paper-line', '--color-paper-line', 'Paper Line', 'ruled note lines'],
  ['ds-chip--charcoal', '--color-soft-charcoal', 'Soft Charcoal', 'light-theme text'],
  ['ds-chip--caption', '--color-caption-ink', 'Caption Ink', 'print captions'],
  ['ds-chip--aubergine', '--color-aubergine', 'Deep Aubergine', 'journal-cover band'],
  ['ds-chip--violet', '--color-field-violet', 'Field Violet', 'primary accent, countries, focus'],
  ['ds-chip--violet-soft', '--color-field-violet-soft', 'Field Violet Soft', 'washi tape, dark-route accents'],
  ['ds-chip--coral', '--color-collegiate-coral', 'Collegiate Coral', 'places accent on paper'],
  ['ds-chip--coral-soft', '--color-collegiate-coral-soft', 'Coral Soft', 'links and focus on aubergine'],
  ['ds-chip--on-aubergine', '--color-on-aubergine', 'On Aubergine', 'band text'],
  ['ds-chip--on-aubergine-muted', '--color-on-aubergine-muted', 'On Aubergine Muted', 'band labels'],
  ['ds-chip--route-light', '--color-route-light', 'Route Light', 'paper route strokes'],
  ['ds-chip--route-dark', '--color-route-dark', 'Route Dark', 'band lattice strokes'],
];

const typeRoles = [
  ['ds-type--display', '--text-hero-name', 'Display · Cormorant SC 500', 'Kyle Cromwell'],
  ['ds-type--headline', '--text-hero-destination', 'Headline · Cormorant SC 500, uppercase', 'Visited Countries'],
  ['ds-type--kicker', '--text-hero-kicker', 'Kicker · Cormorant SC 600, Field Violet', 'Personal Journal'],
  ['ds-type--body', '--text-base', 'Body · Avenir Next 400', 'A growing record of countries visited, places worth remembering.'],
  ['ds-type--label', '--text-sm', 'Label · Avenir Next 600, tracked uppercase', 'Older archives'],
  ['ds-type--caption', '--text-sm', 'Caption · Avenir Next italic, Caption Ink', 'Machu Picchu, Peru'],
];

const spaces = [
  ['ds-space-bar--2xs', '--space-2xs'],
  ['ds-space-bar--xs', '--space-xs'],
  ['ds-space-bar--sm', '--space-sm'],
  ['ds-space-bar--md', '--space-md'],
  ['ds-space-bar--lg', '--space-lg'],
  ['ds-space-bar--xl', '--space-xl'],
  ['ds-space-bar--2xl', '--space-2xl'],
];

const radii = [
  ['ds-radius-demo--print', '--radius-print', 'photographic prints'],
  ['ds-radius-demo--note', '--radius-note', 'notepads, tabs, the field note'],
  ['ds-radius-demo--sm', '--radius-sm', 'small controls'],
  ['ds-radius-demo--md', '--radius-md', 'compact surfaces'],
  ['ds-radius-demo--lg', '--radius-lg', 'interior-page cards'],
];

const shadows = [
  ['ds-shadow-demo--paper', '--shadow-paper', 'prints; hover state of pressables'],
  ['ds-shadow-demo--note', '--shadow-note', 'notepads and tabs at rest'],
  ['ds-shadow-demo--tape', '--shadow-tape', 'washi tape pieces'],
];

const navSections = [
  ['Foundations', [['#color', 'Color'], ['#typography', 'Typography'], ['#spacing', 'Spacing'], ['#radius', 'Radius'], ['#elevation', 'Elevation']]],
  ['Journal components', [['#component-panel', 'Notepad Panel'], ['#component-tab', 'About Tab'], ['#component-print', 'Travel Print'], ['#component-band', 'Band + Archives']]],
  ['Interior shell', [['#component-nav', 'Navigation']]],
];
---

<Base title="Kyle Cromwell — Design System">
  <div class="ds-layout">
    <nav class="ds-nav" aria-label="Design system contents">
      {navSections.map(([group, links]) => (
        <div>
          <p class="ds-nav-label">{group}</p>
          <ul>
            {links.map(([href, label]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <article>
      <header class="ds-header">
        <h1>The College<br />Field Journal</h1>
        <p class="ds-intro">
          Cream notepads, taped prints, ruled paper, and one aubergine journal-cover band. Violet
          carries countries, coral carries places, and every value below renders live from
          <code>tokens.css</code>.
        </p>
      </header>

      <section id="color">
        <h2>Color</h2>
        <div class="ds-table-wrap">
          <table class="ds-table">
            <thead>
              <tr><th></th><th>Token</th><th>Role</th><th>Used for</th></tr>
            </thead>
            <tbody>
              {colors.map(([className, token, role, use]) => (
                <tr>
                  <td><span class:list={['ds-chip', className]}></span></td>
                  <td><code>{token}</code></td>
                  <td>{role}</td>
                  <td class="ds-use">{use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="ds-note">
          The Dark-Band Coral Rule: on Deep Aubergine, interactive affordances use Coral Soft, never
          Field Violet.
        </p>
      </section>

      <section id="typography">
        <h2>Typography</h2>
        <p class="ds-note">
          Two families only: Cormorant SC for display and Avenir Next for everything else. The
          notebook character comes from composition and materials, not a handwriting font.
        </p>
        <div class="ds-type-scale">
          {typeRoles.map(([className, token, role, sample]) => (
            <div class="ds-type-row">
              <div class="ds-type-meta">
                <code>{token}</code>
                <span class="ds-use">{role}</span>
              </div>
              <p class:list={['ds-type-sample', className]}>{sample}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="spacing">
        <h2>Spacing</h2>
        <div class="ds-space-scale">
          {spaces.map(([className, token]) => (
            <div class="ds-space-row">
              <code>{token}</code>
              <div class:list={['ds-space-bar', className]}></div>
            </div>
          ))}
        </div>
      </section>

      <section id="radius">
        <h2>Radius</h2>
        <div class="ds-radius-grid">
          {radii.map(([className, token, use]) => (
            <figure class="ds-radius-card">
              <div class:list={['ds-radius-demo', className]}></div>
              <figcaption>
                <code>{token}</code>
                <span class="ds-use">{use}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section id="elevation">
        <h2>Elevation</h2>
        <p class="ds-note">
          The Whisper-Shadow Rule: shadow opacity never exceeds 0.09. Depth comes from overlap,
          rotation, and tape, not lift.
        </p>
        <div class="ds-radius-grid">
          {shadows.map(([className, token, use]) => (
            <figure class="ds-radius-card">
              <div class:list={['ds-shadow-demo', className]}></div>
              <figcaption>
                <code>{token}</code>
                <span class="ds-use">{use}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section id="component-panel">
        <h2>Notepad Panel</h2>
        <div class="ds-demo ds-demo--paper ds-demo--roomy">
          <a class="home-destination home-destination--countries ds-panel-demo" href="/countries/">
            <svg class="home-destination-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
            </svg>
            <span class="home-destination-title">Visited<br />Countries</span>
            <span class="home-destination-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="ds-note">
          A sheet torn from a spiral notebook: binding keyholes along the top edge, role-colored
          icon, uppercase Cormorant title with inline arrow, and a rule with a ring node. Hover
          lifts; press scales down.
        </p>
      </section>

      <section id="component-tab">
        <h2>About Tab</h2>
        <div class="ds-demo ds-demo--paper">
          <a class="home-about-tab" href="/about/">
            <span class="home-about-tab-label">About me</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4.5 21c.5-4.2 3-6.5 7.5-6.5s7 2.3 7.5 6.5"></path>
            </svg>
          </a>
        </div>
        <p class="ds-note">
          The quieter bookmark. Vertical with a violet cap at desktop widths (tucked behind the
          countries panel on the homepage, sliding out on hover and focus); a horizontal chip below
          72rem.
        </p>
      </section>

      <section id="component-print">
        <h2>Travel Print</h2>
        <div class="ds-demo ds-demo--paper ds-demo--roomy">
          <figure class="home-travel-print ds-print-demo">
            <span class="home-travel-tape" aria-hidden="true"></span>
            <Image
              src={machuPicchu}
              alt="Machu Picchu emerging through low clouds in Peru"
              widths={[480]}
              sizes="20rem"
              loading="lazy"
            />
            <figcaption>Machu Picchu, Peru</figcaption>
          </figure>
        </div>
        <p class="ds-note">
          A photograph as a physical object: white border, sampled washi tape with torn clip-path
          ends, controlled rotation, and a Caption Ink label. On the homepage the three prints
          shuffle per visit and fade in only after the replacement has decoded.
        </p>
      </section>

      <section id="component-band">
        <h2>Band + Archives</h2>
        <div class="ds-demo ds-demo--aubergine">
          <p class="ds-band-copy">Political science, great food, video games, and time with friends.</p>
          <nav class="home-archive-links" aria-label="Archive links demo">
            <span class="home-archive-label">Older archives</span>
            <span class="home-archive-pair">
              <span class="home-archive-sep" aria-hidden="true">·</span>
              <a href="/chocolate/">Chocolate</a>
            </span>
            <span class="home-archive-pair">
              <span class="home-archive-sep" aria-hidden="true">·</span>
              <a href="/poems/">Poems</a>
            </span>
          </nav>
        </div>
        <p class="ds-note">
          The journal-cover band. Real links carry a plain Coral Soft underline; the label stays
          muted and unlinked; separators are bound to their links so a wrap cannot strand them.
          Focus rings re-scope to Coral Soft on this ground.
        </p>
      </section>

      <section id="component-nav">
        <h2>Navigation (interior shell)</h2>
        <div class="ds-demo ds-nav-demo">
          <a href="#component-nav" class="nav-name">Kyle Cromwell</a>
          <div class="nav-links">
            <a href="#component-nav">Visited Countries</a>
            <a href="#component-nav">Interesting Places</a>
            <a href="#component-nav">About Me</a>
          </div>
        </div>
        <p class="ds-note">
          Starter shell, still monospace: functional on interior pages but outside the Two-Family
          Rule. Slated for replacement as each page is redesigned; not a pattern for new work.
        </p>
      </section>
    </article>
  </div>
</Base>

<style>
  .ds-layout {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .ds-nav {
    display: flex;
    gap: var(--space-lg);
    overflow-x: auto;
    padding-bottom: var(--space-xs);
  }

  .ds-nav > div {
    flex: 0 0 auto;
  }

  .ds-nav-label {
    margin: 0 0 var(--space-xs);
    color: var(--color-accent-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .ds-nav ul {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ds-nav a,
  code {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .ds-header h1 {
    margin-bottom: var(--space-lg);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .ds-intro {
    max-width: var(--max-width-copy);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  section {
    margin-top: var(--space-2xl);
  }

  section > h2 {
    margin: 0 0 var(--space-md);
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--color-border);
    font-size: var(--text-xl);
  }

  .ds-note,
  .ds-use {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .ds-table-wrap {
    overflow-x: auto;
  }

  .ds-table {
    width: 100%;
    border-collapse: collapse;
  }

  .ds-table th,
  .ds-table td {
    padding: var(--space-xs) var(--space-sm) var(--space-xs) 0;
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
    text-align: left;
  }

  .ds-chip {
    display: block;
    width: var(--space-xl);
    height: var(--space-lg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .ds-chip--paper { background: var(--color-paper); }
  .ds-chip--paper-raised { background: var(--color-paper-raised); }
  .ds-chip--paper-muted { background: var(--color-paper-muted); }
  .ds-chip--paper-line { background: var(--color-paper-line); }
  .ds-chip--charcoal { background: var(--color-soft-charcoal); }
  .ds-chip--caption { background: var(--color-caption-ink); }
  .ds-chip--aubergine { background: var(--color-aubergine); }
  .ds-chip--violet { background: var(--color-field-violet); }
  .ds-chip--violet-soft { background: var(--color-field-violet-soft); }
  .ds-chip--coral { background: var(--color-collegiate-coral); }
  .ds-chip--coral-soft { background: var(--color-collegiate-coral-soft); }
  .ds-chip--on-aubergine { background: var(--color-on-aubergine); }
  .ds-chip--on-aubergine-muted { background: var(--color-on-aubergine-muted); }
  .ds-chip--route-light { background: var(--color-route-light); }
  .ds-chip--route-dark { background: var(--color-route-dark); }

  .ds-type-row,
  .ds-space-row {
    display: grid;
    grid-template-columns: minmax(12rem, auto) minmax(0, 1fr);
    gap: var(--space-md);
    align-items: center;
    padding-block: var(--space-sm);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .ds-type-meta {
    display: grid;
    gap: var(--space-2xs);
  }

  .ds-type-sample {
    margin: 0;
    overflow-wrap: anywhere;
    line-height: var(--leading-snug);
  }

  .ds-type--display {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

  .ds-type--headline {
    font-family: var(--font-display);
    font-size: var(--text-hero-destination);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .ds-type--kicker {
    color: var(--color-field-violet);
    font-family: var(--font-display);
    font-size: var(--text-hero-kicker);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .ds-type--body {
    font-size: var(--text-base);
  }

  .ds-type--label {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .ds-type--caption {
    color: var(--color-caption-ink);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .ds-space-scale {
    display: grid;
    gap: var(--space-xs);
  }

  .ds-space-bar {
    height: var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-field-violet);
  }

  .ds-space-bar--2xs { width: var(--space-2xs); }
  .ds-space-bar--xs { width: var(--space-xs); }
  .ds-space-bar--sm { width: var(--space-sm); }
  .ds-space-bar--md { width: var(--space-md); }
  .ds-space-bar--lg { width: var(--space-lg); }
  .ds-space-bar--xl { width: var(--space-xl); }
  .ds-space-bar--2xl { width: var(--space-2xl); }

  .ds-radius-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--min-card-width), 1fr));
    gap: var(--space-md);
  }

  .ds-radius-card {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
  }

  .ds-radius-demo {
    height: var(--space-2xl);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-paper-raised);
  }

  .ds-radius-demo--print { border-radius: var(--radius-print); }
  .ds-radius-demo--note { border-radius: var(--radius-note); }
  .ds-radius-demo--sm { border-radius: var(--radius-sm); }
  .ds-radius-demo--md { border-radius: var(--radius-md); }
  .ds-radius-demo--lg { border-radius: var(--radius-lg); }

  .ds-shadow-demo {
    height: var(--space-2xl);
    border-radius: var(--radius-note);
    background: var(--color-paper-raised);
  }

  .ds-shadow-demo--paper { box-shadow: var(--shadow-paper); }
  .ds-shadow-demo--note { box-shadow: var(--shadow-note); }
  .ds-shadow-demo--tape { box-shadow: var(--shadow-tape); }

  .ds-radius-card figcaption {
    display: grid;
  }

  .ds-demo {
    position: relative;
    isolation: isolate;
    padding: var(--space-lg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .ds-demo--paper {
    background: var(--color-paper);
  }

  .ds-demo--roomy {
    padding-top: var(--space-xl);
  }

  .ds-demo--aubergine {
    display: grid;
    gap: var(--space-md);
    color: var(--color-on-aubergine);
    background: var(--color-aubergine);
  }

  .ds-band-copy {
    margin: 0;
    font-size: var(--text-lg);
  }

  .ds-panel-demo {
    max-width: var(--max-width-narrow);
  }

  /* The homepage's desktop layout rules position the print absolutely;
     the demo copy stays in flow. */
  .ds-print-demo {
    position: static;
    top: auto;
    right: auto;
    width: 100%;
    max-width: 20rem;
    margin-inline: auto;
  }

  .ds-nav-demo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 52rem) {
    .ds-layout {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .ds-nav {
      position: sticky;
      top: calc(var(--header-offset) + var(--space-2xl));
      display: grid;
      overflow: visible;
    }
  }
</style>
