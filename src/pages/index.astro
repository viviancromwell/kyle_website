---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FieldRoutes from '../components/FieldRoutes.astro';
import Bookshelf from '../components/Bookshelf.astro';
import { interestingPlaces } from '../data/interestingPlaces.mjs';
import machuPicchu from '../assets/places/machu-picchu-peru.jpeg';
import mostarBridge from '../assets/places/mostar-bridge-bosnia.jpeg';
import baiPeople from '../assets/places/bai-people-china.jpeg';
import hagiaSophia from '../assets/places/hagia-sophia-istanbul.jpeg';

const placeImages = import.meta.glob('../assets/places/*.{jpeg,png}', { eager: true });

// Pool for the per-visit shuffle; the statically rendered images above stay
// as the no-JS fallback.
const heroPool = await Promise.all(
  interestingPlaces
    .filter((place) => placeImages[`../assets/places/${place.image}`])
    .map(async (place) => {
      const optimized = await getImage({
        src: placeImages[`../assets/places/${place.image}`].default,
        widths: [480, 720, 960],
        format: 'webp',
      });
      return { src: optimized.src, srcset: optimized.srcSet.attribute, alt: place.title };
    })
);

const placeTitle = (file, fallback) =>
  interestingPlaces.find((place) => place.image === file)?.title ?? fallback;
---

<Base
  title="Kyle Cromwell — Personal Journal"
  description="The countries I have visited, the places I still remember, and the interests that leave a trace."
>
  <section class="home-hero-journal" aria-labelledby="home-title">
    <div class="home-hero-paper">
      <FieldRoutes variant="light" />

      <header class="home-hero-copy reveal">
        <h1 id="home-title">Kyle Cromwell</h1>
        <p class="home-hero-kicker">Personal Journal</p>
        <p class="home-hero-intro">
          A growing record of the countries I have visited, and the places I think are worth
          remembering.
        </p>
      </header>

      <Bookshelf />

      <div class="home-hero-media reveal reveal--later">
        <figure class="home-travel-print">
          <span class="home-travel-tape" aria-hidden="true"></span>
          <Image
            src={machuPicchu}
            alt="Machu Picchu emerging through low clouds in Peru"
            widths={[480, 720, 960]}
            sizes="(min-width: 64rem) 38vw, (min-width: 48rem) 48vw, 88vw"
            loading="eager"
          />
          <figcaption>{placeTitle('machu-picchu-peru.jpeg', 'Machu Picchu, Peru')}</figcaption>
        </figure>

        <figure class="home-field-note">
          <span class="home-note-tape" aria-hidden="true"></span>
          <Image
            src={mostarBridge}
            alt="The arched Old Bridge crossing the Neretva River in Mostar"
            widths={[320, 480]}
            sizes="(min-width: 64rem) 19vw, (min-width: 48rem) 27vw, 74vw"
            loading="eager"
          />
          <figcaption>{placeTitle('mostar-bridge-bosnia.jpeg', 'Mostar Bridge, Bosnia')}</figcaption>
        </figure>

        <figure class="home-mini-print">
          <span class="home-mini-tape" aria-hidden="true"></span>
          <Image
            src={hagiaSophia}
            alt="Hagia Sophia's domes and minarets rising over Istanbul"
            widths={[320, 480]}
            sizes="(min-width: 64rem) 16vw, (min-width: 48rem) 24vw, 46vw"
            loading="eager"
          />
          <figcaption>{placeTitle('hagia-sophia-istanbul.jpeg', 'Hagia Sophia, Istanbul')}</figcaption>
        </figure>
      </div>
    </div>

    <div class="home-journal-band" role="region" aria-label="My interests">
      <FieldRoutes variant="dark" />
      <div class="home-journal-copy">
        <p>Political science, history, chess, great food, video games, and time with friends.</p>
        <nav class="home-archive-links" aria-labelledby="archive-label">
          <span class="home-archive-label" id="archive-label">Older archives</span>
          <span class="home-archive-pair">
            <span class="home-archive-sep" aria-hidden="true">·</span>
            <a href="/chocolate/">Chocolate</a>
          </span>
          <span class="home-archive-pair">
            <span class="home-archive-sep" aria-hidden="true">·</span>
            <a href="/poems/">Poems</a>
          </span>
        </nav>
      </div>

      <figure class="home-journal-glimpse">
        <Image
          src={baiPeople}
          alt="Lunch with a Bai family near Dali in Yunnan, China"
          widths={[360, 540]}
          sizes="(min-width: 64rem) 27vw, (min-width: 48rem) 38vw, 82vw"
          loading="eager"
        />
        <figcaption>{placeTitle('bai-people-china.jpeg', 'Near Dali in Yunnan, China')}</figcaption>
      </figure>
    </div>
  </section>

  <script is:inline define:vars={{ heroPool }}>
    const figures = ['.home-travel-print', '.home-field-note', '.home-mini-print', '.home-journal-glimpse']
      .map((selector) => document.querySelector(selector))
      .filter(Boolean);
    const pool = [...heroPool];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    figures.forEach((figure, i) => {
      const pick = pool[i];
      if (!pick) return;
      const img = figure.querySelector('img');
      const caption = figure.querySelector('figcaption');
      const next = new Image();
      next.srcset = pick.srcset;
      next.sizes = img.sizes || '';
      next.src = pick.src;
      next
        .decode()
        .then(() => {
          img.style.opacity = '0';
          let swapped = false;
          const swap = () => {
            if (swapped) return;
            swapped = true;
            img.srcset = pick.srcset;
            img.src = pick.src;
            img.alt = '';
            if (caption) caption.textContent = pick.alt;
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                img.style.opacity = '1';
              });
            });
          };
          img.addEventListener('transitionend', swap, { once: true });
          setTimeout(swap, 400);
        })
        .catch(() => {});
    });
  </script>
</Base>
